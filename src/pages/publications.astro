---
import PageHero from "@/components/PageHero.astro";
import PlaceholderNote from "@/components/PlaceholderNote.astro";
import PublicationList from "@/components/PublicationList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";
import { getDataCollection } from "@/utils/content";

const locale = "ja";
const page = pages.publications;
const publications = await getDataCollection("publications");
---

<BaseLayout locale={locale} page="publications" title={page.title.ja} description={page.description.ja}>
  <PageHero title={page.title.ja} description={page.description.ja} />
  <div class="container">
    <PlaceholderNote locale={locale} />
    <PublicationList publications={publications} locale={locale} />
  </div>
</BaseLayout>
