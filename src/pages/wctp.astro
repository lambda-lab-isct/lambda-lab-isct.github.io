---
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";

const locale = "ja";
const page = pages.wctp;
---

<BaseLayout
  locale={locale}
  page="wctp"
  title={page.title.ja}
  description={page.description.ja}
>
  <PageHero title={page.title.ja} description={page.description.ja} />
  <section class="section">
    <div class="container">
      <p>
        過去のWCTP Webサイトは現在移行準備中です。準備が整い次第、このページからご案内します。
      </p>
    </div>
  </section>
</BaseLayout>
