---
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";
import { getDataCollection } from "@/utils/content";

const locale = "zh";
const page = pages.access;
const [profile] = await getDataCollection("members");
---

<BaseLayout
  locale={locale}
  page="access"
  title={page.title.zh}
  description={page.description.zh}
>
  <PageHero title={page.title.zh} description={page.description.zh} />
  <section class="section">
    <div class="container">
      <h2>所在</h2>
      <p>{profile.address?.zh}</p>
      <h2>連絡</h2>
      <p>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>
