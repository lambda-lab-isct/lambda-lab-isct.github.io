---
import MemberList from "@/components/MemberList.astro";
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";
import { byOrder, getDataCollection } from "@/utils/content";

const locale = "zh";
const page = pages.members;
const members = byOrder(await getDataCollection("members"));
---

<BaseLayout
  locale={locale}
  page="members"
  title={page.title.zh}
  description={page.description.zh}
>
  <PageHero title={page.title.zh} description={page.description.zh} />
  <div class="container">
    <MemberList members={members} locale={locale} />
  </div>
</BaseLayout>
