---
import NewsList from "@/components/NewsList.astro";
import PageHero from "@/components/PageHero.astro";
import PlaceholderNote from "@/components/PlaceholderNote.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";
import { byDateDesc, getDataCollection } from "@/utils/content";

const locale = "ja";
const page = pages.news;
const news = byDateDesc(await getDataCollection("news"));
---

<BaseLayout locale={locale} page="news" title={page.title.ja} description={page.description.ja}>
  <PageHero title={page.title.ja} description={page.description.ja} />
  <section class="section">
    <div class="container">
      <PlaceholderNote locale={locale} />
      <NewsList items={news} locale={locale} />
    </div>
  </section>
</BaseLayout>
