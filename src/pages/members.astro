---
import MemberList from "@/components/MemberList.astro";
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";
import { byOrder, getDataCollection } from "@/utils/content";

const locale = "ja";
const page = pages.members;
const members = byOrder(await getDataCollection("members"));
---

<BaseLayout locale={locale} page="members" title={page.title.ja} description={page.description.ja}>
  <PageHero title={page.title.ja} description={page.description.ja} />
  <div class="container">
    <MemberList members={members} locale={locale} />
  </div>
</BaseLayout>
