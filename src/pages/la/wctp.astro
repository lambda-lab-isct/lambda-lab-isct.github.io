---
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages, wctpArchiveLinks } from "@/config/site";

const locale = "la";
const page = pages.wctp;
---

<BaseLayout locale={locale} page="wctp" title={page.title.la} description={page.description.la}>
  <PageHero title={page.title.la} description={page.description.la} />
  <section class="section">
    <div class="container">
      <h2>Archivum WCTP</h2>
      <ul class="list-plain">
        {
          wctpArchiveLinks.map((archive) => (
            <li class="card">
              <h3>
                <a href={archive.path}>{archive.label.la}</a>
              </h3>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
