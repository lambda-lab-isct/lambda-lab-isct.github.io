---
import PageHero from "@/components/PageHero.astro";
import PublicationList from "@/components/PublicationList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";
import publicationsData from "@/data/publications.json";

const locale = "la";
const page = pages.publications;
const publications = publicationsData.records;
---

<BaseLayout
  locale={locale}
  page="publications"
  title={page.title.la}
  description={page.description.la}
>
  <PageHero title={page.title.la} description={page.description.la} />
  <div class="container">
    <p>Haec pagina selectionem publicationum praecipuarum exhibet.</p>
    <PublicationList publications={publications} locale={locale} />
  </div>
</BaseLayout>
