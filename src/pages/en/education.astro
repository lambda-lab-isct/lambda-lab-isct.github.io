---
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";

const locale = "en";
const page = pages.education;
---

<BaseLayout
  locale={locale}
  page="education"
  title={page.title.en}
  description={page.description.en}
>
  <PageHero title={page.title.en} description={page.description.en} />
  <section class="section">
    <div class="container">
      <p>
        Information about educational activities will be added as it becomes
        available.
      </p>
    </div>
  </section>
</BaseLayout>
