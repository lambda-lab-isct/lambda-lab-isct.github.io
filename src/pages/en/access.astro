---
import PageHero from "@/components/PageHero.astro";
import PlaceholderNote from "@/components/PlaceholderNote.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";

const locale = "en";
const page = pages.access;
---

<BaseLayout locale={locale} page="access" title={page.title.en} description={page.description.en}>
  <PageHero title={page.title.en} description={page.description.en} />
  <section class="section">
    <div class="container">
      <PlaceholderNote locale={locale} />
      <h2>Access</h2>
      <p>Address, building, and laboratory location details have not been provided yet. Publish only verified information.</p>
      <h2>Contact</h2>
      <p>General email address, phone number, and contact workflow have not been provided yet. Confirm publication permission before adding personal information.</p>
    </div>
  </section>
</BaseLayout>
