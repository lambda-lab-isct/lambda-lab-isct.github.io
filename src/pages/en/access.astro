---
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";
import { getDataCollection } from "@/utils/content";

const locale = "en";
const page = pages.access;
const [profile] = await getDataCollection("members");
---

<BaseLayout locale={locale} page="access" title={page.title.en} description={page.description.en}>
  <PageHero title={page.title.en} description={page.description.en} />
  <section class="section">
    <div class="container">
      <h2>Access</h2>
      <p>{profile.address?.en}</p>
      <h2>Contact</h2>
      <p>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>
