---
import PageHero from "@/components/PageHero.astro";
import PlaceholderNote from "@/components/PlaceholderNote.astro";
import SeminarList from "@/components/SeminarList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";
import { byDateDesc, getDataCollection } from "@/utils/content";

const locale = "en";
const page = pages.seminars;
const seminars = byDateDesc(await getDataCollection("seminars"));
---

<BaseLayout locale={locale} page="seminars" title={page.title.en} description={page.description.en}>
  <PageHero title={page.title.en} description={page.description.en} />
  <section class="section">
    <div class="container">
      <PlaceholderNote locale={locale} />
      <SeminarList seminars={seminars} locale={locale} />
    </div>
  </section>
</BaseLayout>
