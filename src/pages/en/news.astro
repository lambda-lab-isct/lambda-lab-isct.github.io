---
import NewsList from "@/components/NewsList.astro";
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";
import { byDateDesc, getDataCollection } from "@/utils/content";

const locale = "en";
const page = pages.news;
const news = byDateDesc(await getDataCollection("news"));
---

<BaseLayout
  locale={locale}
  page="news"
  title={page.title.en}
  description={page.description.en}
  robots="noindex, follow"
>
  <PageHero title={page.title.en} description={page.description.en} />
  <section class="section">
    <div class="container">
      <NewsList items={news} locale={locale} />
    </div>
  </section>
</BaseLayout>
