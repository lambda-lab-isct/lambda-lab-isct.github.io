---
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";

const locale = "en";
const page = pages.wctp;
---

<BaseLayout
  locale={locale}
  page="wctp"
  title={page.title.en}
  description={page.description.en}
>
  <PageHero title={page.title.en} description={page.description.en} />
  <section class="section">
    <div class="container">
      <p>
        Past WCTP websites are being prepared for migration. Links will be
        provided on this page when they become available.
      </p>
    </div>
  </section>
</BaseLayout>
