---
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages, wctpArchiveLinks } from "@/config/site";

const locale = "en";
const page = pages.wctp;
---

<BaseLayout
  locale={locale}
  page="wctp"
  title={page.title.en}
  description={page.description.en}
>
  <PageHero title={page.title.en} description={page.description.en} />
  <section class="section">
    <div class="container">
      <h2>WCTP Archive</h2>
      <ul class="list-plain">
        {
          wctpArchiveLinks.map((archive) => (
            <li class="card">
              <h3>
                <a href={archive.path}>{archive.label.en}</a>
              </h3>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
