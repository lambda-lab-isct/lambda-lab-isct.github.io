---
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";

const locale = "en";
const page = pages.wctp;
---

<BaseLayout locale={locale} page="wctp" title={page.title.en} description={page.description.en}>
  <PageHero title={page.title.en} description={page.description.en} />
  <section class="section">
    <div class="container">
      <h2>WCTP Archive</h2>
      <p>
        This is the WCTP entry page. Past static HTML, CSS, images, and PDFs can be placed under
        <code>public/wctp/archive/</code>. No real WCTP2025 or WCTP2026 data has been created yet.
      </p>
      <p>
        Migrated HTML will be served under <code>/wctp/archive/</code>.
      </p>
    </div>
  </section>
</BaseLayout>
