---
import PageHero from "@/components/PageHero.astro";
import PlaceholderNote from "@/components/PlaceholderNote.astro";
import ResearchList from "@/components/ResearchList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";
import { byOrder, getDataCollection } from "@/utils/content";

const locale = "en";
const page = pages.research;
const research = byOrder(await getDataCollection("research"));
---

<BaseLayout locale={locale} page="research" title={page.title.en} description={page.description.en}>
  <PageHero title={page.title.en} description={page.description.en} />
  <section class="section">
    <div class="container">
      <PlaceholderNote locale={locale} />
      <ResearchList items={research} locale={locale} />
    </div>
  </section>
</BaseLayout>
