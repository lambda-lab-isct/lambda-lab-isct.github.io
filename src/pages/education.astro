---
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/config/site";

const locale = "ja";
const page = pages.education;
---

<BaseLayout
  locale={locale}
  page="education"
  title={page.title.ja}
  description={page.description.ja}
  robots="noindex, follow"
>
  <PageHero title={page.title.ja} description={page.description.ja} />
  <section class="section">
    <div class="container">
      <p>教育活動に関する情報は、内容を確認のうえ順次掲載します。</p>
    </div>
  </section>
</BaseLayout>
