---
import NewsList from "@/components/NewsList.astro";
import PageHero from "@/components/PageHero.astro";
import ResearchList from "@/components/ResearchList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages, siteConfig } from "@/config/site";
import { byDateDesc, byOrder, getDataCollection } from "@/utils/content";

const locale = "ja";
const research = byOrder(await getDataCollection("research"));
const news = byDateDesc(await getDataCollection("news"));
---

<BaseLayout
  locale={locale}
  page="home"
  title={pages.home.title.ja}
  description={siteConfig.description.ja}
>
  <PageHero title="Lambda Laboratory" description={siteConfig.description.ja} />
  <section class="section">
    <div class="container">
      <h2>概要</h2>
      <p>
        Lambda
        Laboratoryでは、プログラミング言語理論、型システム、形式手法とその応用に関する研究を行っています。本サイトでは、研究テーマ、メンバー、研究業績などを紹介します。
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>研究テーマ</h2>
      <ResearchList items={research} locale={locale} />
    </div>
  </section>
  {
    news.length > 0 && (
      <section class="section">
        <div class="container">
          <h2>ニュース</h2>
          <NewsList items={news.slice(0, 3)} locale={locale} />
        </div>
      </section>
    )
  }
</BaseLayout>
