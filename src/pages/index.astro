---
import PageHero from "@/components/PageHero.astro";
import ResearchList from "@/components/ResearchList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages, siteConfig } from "@/config/site";
import { byOrder, getDataCollection } from "@/utils/content";

const locale = "ja";
const research = byOrder(await getDataCollection("research"));
---

<BaseLayout
  locale={locale}
  page="home"
  title={pages.home.title.ja}
  description={siteConfig.description.ja}
>
  <PageHero title="Lambda Laboratory" description={siteConfig.description.ja} />
  <section class="section">
    <div class="container">
      <h2>概要</h2>
      <p>
        Lambda
        Laboratoryでは、プログラミング言語理論、型システム、形式手法とその応用に関する研究を行っています。本サイトでは、研究テーマ、メンバー、研究業績などを紹介します。
      </p>
      <ul class="list-plain">
        <li><a href={pages.research.path[locale]}>研究テーマを見る</a></li>
        <li><a href={pages.members.path[locale]}>メンバーを見る</a></li>
        <li><a href={pages.publications.path[locale]}>研究業績を見る</a></li>
      </ul>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>研究テーマ</h2>
      <ResearchList items={research} locale={locale} />
    </div>
  </section>
</BaseLayout>
