---
import type { Locale } from "@/config/site";

interface Publication {
  publication_id: string;
  title: string;
  title_english?: string;
  authors: string;
  authors_romanized?: string;
  publication_year: number;
  publication_date?: string;
  publication_type?: string;
  language?: string;
  journal_or_proceedings_title?: string;
  volume?: string;
  issue?: string;
  start_page?: string;
  end_page?: string;
  article_number?: string;
  publisher?: string;
  conference_name?: string;
  series_title?: string;
  doi?: string;
  doi_url?: string;
  url?: string;
  open_access_url?: string;
  repository_url?: string;
  abstract?: string;
}

interface Props {
  publications: Publication[];
  locale: Locale;
}

const { publications, locale } = Astro.props;
const uiText = {
  ja: {
    noEntries: "公開中の業績はありません。",
    openAccess: "オープンアクセス",
    repository: "リポジトリ",
    abstract: "概要",
  },
  en: {
    noEntries: "No public entries.",
    openAccess: "Open access",
    repository: "Repository",
    abstract: "Abstract",
  },
  la: {
    noEntries: "Nullae publicationes publicae adsunt.",
    openAccess: "Accessus apertus",
    repository: "Repositorium",
    abstract: "Summarium",
  },
  zh: {
    noEntries: "未有公開論著。",
    openAccess: "公開閲覧",
    repository: "保管所",
    abstract: "要旨",
  },
} as const satisfies Record<Locale, Record<string, string>>;

function venueParts(publication: Publication) {
  return [
    publication.journal_or_proceedings_title,
    publication.conference_name,
    publication.series_title,
    publication.volume && `Vol. ${publication.volume}`,
    publication.issue && `No. ${publication.issue}`,
    publication.article_number && `Article ${publication.article_number}`,
    publication.start_page &&
      publication.end_page &&
      `${publication.start_page}-${publication.end_page}`,
    publication.publisher,
  ].filter(Boolean);
}
---

<section class="section">
  {
    publications.length === 0 ? (
      <p class="meta">{uiText[locale].noEntries}</p>
    ) : (
      <ol class="publication-list">
        {publications.map((publication) => (
          <li class="publication-item" id={publication.publication_id}>
            <article>
              <p class="meta">{publication.publication_year}</p>
              <h2>{publication.title}</h2>
              <p>{publication.authors}</p>
              {venueParts(publication).length > 0 && (
                <p class="meta">{venueParts(publication).join(", ")}</p>
              )}
              <p class="publication-links">
                {publication.doi && publication.doi_url && (
                  <a href={publication.doi_url}>DOI: {publication.doi}</a>
                )}
                {publication.url && <a href={publication.url}>URL</a>}
                {publication.open_access_url && (
                  <a href={publication.open_access_url}>{uiText[locale].openAccess}</a>
                )}
                {publication.repository_url && (
                  <a href={publication.repository_url}>{uiText[locale].repository}</a>
                )}
              </p>
              {publication.abstract && (
                <details>
                  <summary>{uiText[locale].abstract}</summary>
                  <p>{publication.abstract}</p>
                </details>
              )}
            </article>
          </li>
        ))}
      </ol>
    )
  }
</section>
