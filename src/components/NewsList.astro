---
import type { Locale } from "@/config/site";
import { t } from "@/utils/i18n";

interface NewsItem {
  date: string;
  title: Record<Locale, string>;
  body: Record<Locale, string>;
  url?: string;
}

interface Props {
  items: NewsItem[];
  locale: Locale;
}

const { items, locale } = Astro.props;
const uiText = {
  ja: {
    noEntries: "現在掲載中のお知らせはありません。",
    details: "詳細",
  },
  en: {
    noEntries: "There are currently no announcements.",
    details: "Details",
  },
  la: {
    noEntries: "Nuntii publici nunc non adsunt.",
    details: "Singula",
  },
} as const satisfies Record<Locale, Record<string, string>>;
---

{
  items.length === 0 ? (
    <p class="meta">{uiText[locale].noEntries}</p>
  ) : (
    <ul class="list-plain">
      {items.map((item) => (
        <li class="card">
          <time datetime={item.date} class="meta">
            {item.date}
          </time>
          <h3>{t(item.title, locale)}</h3>
          <p>{t(item.body, locale)}</p>
          {item.url && <a href={item.url}>{uiText[locale].details}</a>}
        </li>
      ))}
    </ul>
  )
}
