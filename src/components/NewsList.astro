---
import type { Locale } from "@/config/site";
import { t } from "@/utils/i18n";

interface NewsItem {
  date: string;
  title: Record<Locale, string>;
  body: Record<Locale, string>;
  url?: string;
}

interface Props {
  items: NewsItem[];
  locale: Locale;
}

const { items, locale } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="meta">
      {locale === "ja"
        ? "現在掲載中のお知らせはありません。"
        : "There are currently no announcements."}
    </p>
  ) : (
    <ul class="list-plain">
      {items.map((item) => (
        <li class="card">
          <time datetime={item.date} class="meta">
            {item.date}
          </time>
          <h3>{t(item.title, locale)}</h3>
          <p>{t(item.body, locale)}</p>
          {item.url && (
            <a href={item.url}>{locale === "ja" ? "詳細" : "Details"}</a>
          )}
        </li>
      ))}
    </ul>
  )
}
