---
import type { Locale } from "@/config/site";
import { t } from "@/utils/i18n";

interface Item {
  title: Record<Locale, string>;
  summary: Record<Locale, string>;
  tags: Record<Locale, string>[];
  isPlaceholder: boolean;
}

interface Props {
  items: Item[];
  locale: Locale;
}

const { items, locale } = Astro.props;
---

<div class="grid">
  {
    items.map((item) => (
      <article class="card">
        <h3>{t(item.title, locale)}</h3>
        <p>{t(item.summary, locale)}</p>
        {item.tags.length > 0 && (
          <p class="meta">
            {item.tags.map((tag) => t(tag, locale)).join(" / ")}
            {item.isPlaceholder ? ` - ${locale === "ja" ? "プレースホルダー" : "Placeholder"}` : ""}
          </p>
        )}
      </article>
    ))
  }
</div>
