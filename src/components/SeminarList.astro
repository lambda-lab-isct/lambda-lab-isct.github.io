---
import type { Locale } from "@/config/site";
import { t } from "@/utils/i18n";

interface Seminar {
  date: string;
  title: Record<Locale, string>;
  speaker: Record<Locale, string>;
  venue: Record<Locale, string>;
  abstract?: Record<Locale, string>;
}

interface Props {
  seminars: Seminar[];
  locale: Locale;
}

const { seminars, locale } = Astro.props;
const uiText = {
  ja: {
    noEntries: "現在掲載中のセミナー情報はありません。",
    speaker: "講演者:",
    venue: "会場:",
  },
  en: {
    noEntries: "There are currently no seminar announcements.",
    speaker: "Speaker:",
    venue: "Venue:",
  },
  la: {
    noEntries: "Nuntii seminariorum nunc non adsunt.",
    speaker: "Orator:",
    venue: "Locus:",
  },
  zh: {
    noEntries: "今無公開講会。",
    speaker: "講者:",
    venue: "会場:",
  },
} as const satisfies Record<Locale, Record<string, string>>;
---

{
  seminars.length === 0 ? (
    <p class="meta">{uiText[locale].noEntries}</p>
  ) : (
    <ul class="list-plain">
      {seminars.map((seminar) => (
        <li class="card">
          <time datetime={seminar.date} class="meta">
            {seminar.date}
          </time>
          <h3>{t(seminar.title, locale)}</h3>
          <p>
            <strong>{uiText[locale].speaker}</strong> {t(seminar.speaker, locale)}
          </p>
          <p>
            <strong>{uiText[locale].venue}</strong> {t(seminar.venue, locale)}
          </p>
          {seminar.abstract && <p>{t(seminar.abstract, locale)}</p>}
        </li>
      ))}
    </ul>
  )
}
