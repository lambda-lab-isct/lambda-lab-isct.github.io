---
import "@/styles/global.css";
import {
  navigationPages,
  pages,
  siteConfig,
  type Locale,
  type PageKey,
} from "@/config/site";
import {
  getAlternatePath,
  getCanonicalUrl,
  localeLanguageTags,
  localeLabels,
  t,
} from "@/utils/i18n";

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  robots?: string;
}

const { locale, page, title, description, robots } = Astro.props;
const canonicalUrl = getCanonicalUrl(pages[page].path[locale]);
const languageLinks = siteConfig.locales.map((targetLocale) => ({
  locale: targetLocale,
  languageTag: localeLanguageTags[targetLocale],
  path: getAlternatePath(page, targetLocale),
  label: localeLabels[targetLocale],
  isCurrent: targetLocale === locale,
}));
const languageTag = localeLanguageTags[locale];
const fullTitle =
  page === "home" ? siteConfig.name[locale] : `${title} | ${siteConfig.name[locale]}`;
const uiText = {
  ja: {
    skip: "本文へ移動",
    brandNote: "Institute of Science Tokyo の研究室サイト",
    primaryNav: "主要ナビゲーション",
    languageSwitch: "言語切替",
    language: "言語:",
    footer:
      "このサイトは Science Tokyo 公式サイトではなく、Lambda Laboratory 独自のWebサイトです。",
  },
  en: {
    skip: "Skip to main content",
    brandNote: "An independent laboratory website at Institute of Science Tokyo",
    primaryNav: "Primary navigation",
    languageSwitch: "Language switch",
    language: "Language:",
    footer:
      "This is an independent Lambda Laboratory website, not the official Science Tokyo website.",
  },
  la: {
    skip: "Ad textum principalem transire",
    brandNote: "Pagina laboratorii apud Institute of Science Tokyo",
    primaryNav: "Navigatio primaria",
    languageSwitch: "Mutatio linguae",
    language: "Lingua:",
    footer:
      "Haec pagina est situs proprius Laboratorii Lambda, non situs officialis Science Tokyo.",
  },
  zh: {
    skip: "至本文",
    brandNote: "Institute of Science Tokyo研究室頁",
    primaryNav: "主要導引",
    languageSwitch: "言語切替",
    language: "言語:",
    footer: "此乃λ研究室自設頁非Science Tokyo公式頁。",
  },
} satisfies Record<Locale, Record<string, string>>;
---

<!doctype html>
<html lang={languageTag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />
    {
      siteConfig.locales.map((targetLocale) => (
        <link
          rel="alternate"
          hreflang={localeLanguageTags[targetLocale]}
          href={getCanonicalUrl(pages[page].path[targetLocale])}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={getCanonicalUrl(pages[page].path.ja)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name[locale]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {uiText[locale].skip}
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={pages.home.path[locale]}>
          <span class="brand-name">{siteConfig.name[locale]}</span>
          <span class="brand-note">{uiText[locale].brandNote}</span>
        </a>
        <nav aria-label={uiText[locale].primaryNav}>
          <ul class="nav-list">
            {
              navigationPages.map((key) => {
                const item = pages[key];
                return (
                <li>
                  <a
                    href={item.path[locale]}
                    aria-current={key === page ? "page" : undefined}
                  >
                    {t(item.label, locale)}
                  </a>
                </li>
                );
              })
            }
          </ul>
        </nav>
        <div class="language-switch" aria-label={uiText[locale].languageSwitch}>
          <span>{uiText[locale].language}</span>
          <ul>
            {
              languageLinks.map((link) => (
                <li>
                  <a
                    href={link.path}
                    hreflang={link.languageTag}
                    lang={link.languageTag}
                    aria-current={link.isCurrent ? "true" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>
          &copy; {new Date().getFullYear()} {siteConfig.name[locale]}. {uiText[locale].footer}
        </p>
      </div>
    </footer>
  </body>
</html>
